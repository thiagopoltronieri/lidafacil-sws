# modelo de configuração do Lida Fácil

# ambiente: dev, test ou prod
APP_ENV=dev
APP_DEBUG=true

# fuso horário usado nas regras de data e nos timestamps
APP_TZ=America/Sao_Paulo

# porta do host onde a aplicação fica exposta, fora dos padrões para não colidir com outros projetos locais; no container o apache escuta na 8080
APP_PORT=8793

# banco de dados: os testes usam sqlite em memória; a aplicação roda em mysql via docker compose (não gosto de Postgres)
# o driver abaixo vale para execuções fora do compose (ex.: rodar bin/migrate.php direto); no compose o app já usa mysql
DB_DRIVER=mysql
DB_PATH=var/data/lidafacil.sqlite

# credenciais do mysql: o compose cria o banco e o usuário com estes valores
DB_NAME=lidafacil
DB_USER=lidafacil
DB_PASSWORD=troque-esta-senha-no-env
# senha do root do mysql, só vive dentro do container
DB_ROOT_PASSWORD=troque-esta-senha-root

# host e porta para conexão fora do compose; dentro da rede do compose o app fala com lidafacil-db:3306
DB_HOST=127.0.0.1
DB_PORT=33193
# porta que o serviço do banco publica no host
DB_HOST_PORT=33193

# jwt: o segredo assina os tokens de acesso (hs256); gerar um valor forte e aleatório, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_ISSUER=lidafacil-sws
# validade do access token em segundos (900 = 15 min) e do refresh token (604800 = 7 dias)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# origens liberadas no cors, separadas por vírgula; deixe vazio quando a spa é servida na mesma origem da api
CORS_ALLOWED_ORIGINS=

# usuários semeados no primeiro start, um por perfil; só entram os que tiverem senha definida
SEED_ADMIN_NAME=Administrador Demonstração
SEED_ADMIN_EMAIL=admin@lidafacil.local
SEED_ADMIN_PASSWORD=troque-esta-senha-admin

SEED_OPERATOR_NAME=Operador Demonstração
SEED_OPERATOR_EMAIL=operator@lidafacil.local
SEED_OPERATOR_PASSWORD=troque-esta-senha-operator

SEED_CLIENT_NAME=Cliente Demonstração
SEED_CLIENT_EMAIL=client@lidafacil.local
SEED_CLIENT_PASSWORD=troque-esta-senha-client
